[Unit]
Description=Mafutani backend (stdlib-only Python)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/minima/Documents/Projects/Mafutani-main
Environment=PORT=8000
Environment=MAFUTANI_NO_FEED=1
ExecStart=/usr/bin/python3 /home/minima/Documents/Projects/Mafutani-main/app.py
Restart=on-failure
RestartSec=3
# Run as a non-root user in production; adjust as needed.
User=minima
Group=minima

[Install]
WantedBy=multi-user.target
